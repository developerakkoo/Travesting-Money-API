# Sign Secure (SignPad API)
SIGNSECURE_BASE_URL=https://api-stg.signpad.signsecure.in
SIGNSECURE_API_TOKEN=
# HTTPS URL users return to after signing (must match create-envelope workflow.redirectUrl)
SIGNSECURE_REDIRECT_URL=https://travesting-user.web.app/services
# Must match literal text in generated PDF (see pdf-generation.service.ts)
SIGNSECURE_SIGN_ANCHOR_TEXT=Client Signature:
# Optional webhook verification (if Sign Secure sends a shared secret header)
SIGNSECURE_WEBHOOK_SECRET=

# Feature flag: disable Sign Secure routes if false
USE_SIGNSECURE=true
